        callback(200, {}, JSON.stringify({}));
      });

      runCode(scenarioMockData);

      assertApi('sendHttpRequest').wasCalled();
      assertApi('gtmOnSuccess').wasCalled();
      assertApi('gtmOnFailure').wasNotCalled();
    });
