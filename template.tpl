setup: |-
  const JSON = require('JSON');
  const Object = require('Object');

  const assign = (target, source) => {
    if (!source) return target;
    const keys = Object.keys(source);
    keys.forEach((key) => {
      target[key] = source[key];
    });
    return target;
  };

  const baseMockData = {
    eventType: 'order',
    apiKey: 'testApiKey123',
    useOptimisticScenario: false,
    adStorageConsent: 'optional',
    orderId: 'ORDER-1',
    purchaseDate: undefined,
    cid: undefined,
    email: 'buyer@example.com',
    orderProperties: [],
    orderCustomProperties: [],
    address: 'newcontact@example.com',
    primaryKey: 'contact123',
    useSecondaryIdentifier: false,
    secondaryKeyName: undefined,
    secondaryKeyValue: undefined,
    createContactParameters: []
  };

  const createMockData = (overrides) => assign(assign({}, baseMockData), overrides || {});

  const cleanupMocks = () => {
    mock('getAllEventData', () => ({page_location: 'https://example.com/checkout'}));
    mock('getCookieValues', () => []);
  };

  cleanupMocks();
  mock('getRequestHeader', () => undefined);
  mock('getTimestampMillis', 1712000000000);
  mock('sendHttpRequest', (url, callback, options, body) => {
    if (callback) callback(200, {}, JSON.stringify({}));
  });

  const mockData = createMockData({});


